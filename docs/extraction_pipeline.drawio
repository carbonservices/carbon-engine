<mxfile host="app.diagrams.net" modified="2026-10-10T20:50:00.000Z" agent="CarbonEngine" version="24.0.0" type="device">
  <diagram id="carbon-engine-ExtractionPipeline" name="ExtractionPipeline">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title_pipe" value="Carbon Engine — Targeted Statutory Extraction &amp; Recovery Pipeline&lt;br&gt;Two-Tier Scoped RAG | FactStore Memoization | Context Budget Guard | Multi-Pass JSON Sanitizer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1480" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="s1" value="Step 1: FactStore Memoization&lt;br&gt;- Check known company anchors:&lt;br&gt;  Turnover, FY, Employee Headcount, CIN&lt;br&gt;- Pre-inject into prompt header" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#1e3a8a;fontStyle=1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="110" width="280" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="Step 2: Two-Tier Scoped Retrieval&lt;br&gt;- Tier A: Page Locality Window (±2 chunks around anchor page)&lt;br&gt;- Tier B: FAISS HNSW Vector Search (k=6 semantic match)&lt;br&gt;- Deduplicate candidate chunk IDs in RAM&lt;br&gt;- Single batched SQLite fetch: getChunksByIds(ids)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#8b5cf6;fontColor=#4c1d95;fontStyle=1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="100" width="360" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="Step 3: Context Budget Guard&lt;br&gt;- Hard limit context text to 2,400 tokens / 9,000 chars&lt;br&gt;- Middle-Out Trimming: Never truncate tail of prompt&lt;br&gt;- Preserves JSON schema instructions &amp; assistant role turn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontStyle=1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="790" y="100" width="340" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="Step 4: Local LLM Generation&lt;br&gt;- LlamaEngine (Qwen 2.5 7B Instruct GGUF)&lt;br&gt;- Accelerated by NVIDIA CUDA or Intel MKL AVX2&lt;br&gt;- Autoregressive JSON completion generation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;fontColor=#14532d;fontStyle=1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1180" y="100" width="320" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="s5" value="Step 5: Multi-Pass JSON Sanitizer (autoRepairJson)&lt;br&gt;- Strips markdown code fences (```json ... ```)&lt;br&gt;- Repairs syntax errors inside non-string tokens:&lt;br&gt;  &amp;bull; &#x27;: ,&#x27; &amp;rarr; &#x27;: null,&#x27;&lt;br&gt;  &amp;bull; &#x27;: -&#x27; &amp;rarr; &#x27;: null,&#x27; (dashes in table cells)&lt;br&gt;  &amp;bull; &#x27;: N/A&#x27; &amp;rarr; &#x27;: null,&#x27;&lt;br&gt;  &amp;bull; Dangling colons: &#x27;&quot;key&quot;:&#x27; &amp;rarr; &#x27;&quot;key&quot;: null&#x27;&lt;br&gt;  &amp;bull; Balances open braces and brackets stack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;fontStyle=1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1180" y="260" width="320" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="s6" value="Step 6: Regex Fallback Harvester (parseOrRecoverJson)&lt;br&gt;- If standard nlohmann::json parse fails:&lt;br&gt;- Scans raw buffer with resilient regex for all valid key-value pairs:&lt;br&gt;  &amp;bull; Numeric values, strings, booleans, and sub-arrays&lt;br&gt;- Salvages extracted metrics without dropping the section" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;fontStyle=1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="790" y="260" width="340" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="s7" value="Step 7: Persistence &amp; FactStore Update&lt;br&gt;- Saves cleaned section JSON to SQLite (report_sections)&lt;br&gt;- Updates FactStore with newly discovered base facts&lt;br&gt;- Records source page provenance for auditability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#064e3b;fontStyle=1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="275" width="360" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="s8" value="Step 8: Consultant Review &amp; Verification&lt;br&gt;- Qt Quick Desktop Client (ReportReviewScreen)&lt;br&gt;- Scalar Metrics: 2-column form grid with human SEBI titles&lt;br&gt;- Tabular Loops: Spreadsheet-style data grid (LoopFieldEditor)&lt;br&gt;- Inline cell editing, [+ Add Row], [✕ Delete]&lt;br&gt;- Collapsible missing-field warning badges" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0c4a6e;fontStyle=1;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="450" width="480" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="s9" value="Step 9: Report Acceptance &amp; Export&lt;br&gt;- Consultant clicks [Accept &amp; Lock]&lt;br&gt;- Status set to &#x27;ACCEPTED&#x27; in database&lt;br&gt;- Inja merges verified JSON into template.html&lt;br&gt;- Exports responsive offline HTML / PDF with Chart.js analytics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#be185d;fontColor=#701a75;fontStyle=1;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="580" y="450" width="480" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="p_e1" value="Anchors" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;fontSize=11;fontColor=#334155;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p_e2" value="Candidate Chunks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;fontSize=11;fontColor=#334155;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p_e3" value="Bounded Prompt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;fontSize=11;fontColor=#334155;" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p_e4" value="Raw Output" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;fontSize=11;fontColor=#334155;" edge="1" parent="1" source="s4" target="s5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p_e5" value="On Parse Error" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;fontSize=11;fontColor=#334155;" edge="1" parent="1" source="s5" target="s6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p_e6" value="Clean JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;fontSize=11;fontColor=#334155;" edge="1" parent="1" source="s5" target="s7">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p_e7" value="Recovered Fields" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;fontSize=11;fontColor=#334155;" edge="1" parent="1" source="s6" target="s7">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p_e8" value="Fetch Sections" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;fontSize=11;fontColor=#334155;" edge="1" parent="1" source="s7" target="s8">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p_e9" value="Accept &amp; Lock" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;fontSize=11;fontColor=#334155;" edge="1" parent="1" source="s8" target="s9">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
