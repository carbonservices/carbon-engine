<mxfile host="app.diagrams.net" modified="2026-10-10T20:50:00.000Z" agent="CarbonEngine" version="24.0.0" type="device">
  <diagram id="carbon-engine-DatabaseSchema" name="DatabaseSchema">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title_db" value="Carbon Engine — SQLite Database Schema &amp; Entity Relationships&lt;br&gt;Configured with PRAGMA journal_mode = WAL; PRAGMA foreign_keys = ON; Full ON DELETE CASCADE Durability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1480" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="t_jobs" value="&amp;lt;b&amp;gt;ingestion_jobs&amp;lt;/b&amp;gt; (Root Batch Job Table)&amp;lt;hr&amp;gt;+ &amp;lt;b&amp;gt;id&amp;lt;/b&amp;gt;: INTEGER PRIMARY KEY AUTOINCREMENT&amp;lt;br&amp;gt;+ &amp;lt;b&amp;gt;status&amp;lt;/b&amp;gt;: TEXT NOT NULL (PENDING | PROCESSING | COMPLETED | FAILED)&amp;lt;br&amp;gt;+ &amp;lt;b&amp;gt;error_message&amp;lt;/b&amp;gt;: TEXT&amp;lt;br&amp;gt;+ &amp;lt;b&amp;gt;created_at&amp;lt;/b&amp;gt;: DATETIME DEFAULT CURRENT_TIMESTAMP&amp;lt;br&amp;gt;+ &amp;lt;b&amp;gt;extraction_status&amp;lt;/b&amp;gt;: TEXT DEFAULT &#x27;NOT_STARTED&#x27; (EXTRACTING | EXTRACTED | ACCEPTED)&amp;lt;br&amp;gt;+ &amp;lt;b&amp;gt;report_locked_at&amp;lt;/b&amp;gt;: DATETIME&amp;lt;br&amp;gt;&amp;lt;i&amp;gt;Orchestrates multi-file batch ingestion &amp;amp; statutory extraction lifecycle&amp;lt;/i&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontColor=#1e3a8a;fontSize=12;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="420" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="t_docs" value="&amp;lt;b&amp;gt;job_documents&amp;lt;/b&amp;gt; (Staged Source Documents)&amp;lt;hr&amp;gt;+ &amp;lt;b&amp;gt;id&amp;lt;/b&amp;gt;: INTEGER PRIMARY KEY AUTOINCREMENT&amp;lt;br&amp;gt;+ &amp;lt;b&amp;gt;job_id&amp;lt;/b&amp;gt;: INTEGER NOT NULL [FK &amp;amp;rarr; ingestion_jobs(id) ON DELETE CASCADE]&amp;lt;br&amp;gt;+ &amp;lt;b&amp;gt;file_path&amp;lt;/b&amp;gt;: TEXT NOT NULL&amp;lt;br&amp;gt;+ &amp;lt;b&amp;gt;document_index&amp;lt;/b&amp;gt;: INTEGER DEFAULT 0&amp;lt;br&amp;gt;&amp;lt;i&amp;gt;INDEX idx_job_docs_job ON job_documents(job_id)&amp;lt;/i&amp;gt;&amp;lt;br&amp;gt;&amp;lt;i&amp;gt;Supports 1..N documents per report job (Standalone + Consolidated files)&amp;lt;/i&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWidth=2;fontColor=#4c1d95;fontSize=12;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="380" width="420" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="t_chunks" value="&amp;lt;b&amp;gt;document_chunks&amp;lt;/b&amp;gt; (Parsed Text &amp;amp; Vector Embeddings)&amp;lt;hr&amp;gt;+ &amp;lt;b&amp;gt;id&amp;lt;/b&amp;gt;: INTEGER PRIMARY KEY AUTOINCREMENT [Maps 1:1 to FAISS Vector ID]&amp;lt;br&amp;gt;+ &amp;lt;b&amp;gt;job_id&amp;lt;/b&amp;gt;: INTEGER NOT NULL [FK &amp;amp;rarr; ingestion_jobs(id) ON DELETE CASCADE]&amp;lt;br&amp;gt;+ &amp;lt;b&amp;gt;document_id&amp;lt;/b&amp;gt;: INTEGER [FK &amp;amp;rarr; job_documents(id) ON DELETE CASCADE]&amp;lt;br&amp;gt;+ &amp;lt;b&amp;gt;page_num&amp;lt;/b&amp;gt;: INTEGER NOT NULL (1-based physical page number)&amp;lt;br&amp;gt;+ &amp;lt;b&amp;gt;chunk_text&amp;lt;/b&amp;gt;: TEXT NOT NULL (1500 chars with 300 char overlap)&amp;lt;br&amp;gt;+ &amp;lt;b&amp;gt;vector_id&amp;lt;/b&amp;gt;: INTEGER (Legacy alias, aligned with id)&amp;lt;br&amp;gt;+ &amp;lt;b&amp;gt;topic_labels&amp;lt;/b&amp;gt;: TEXT (Optional keyword tags)&amp;lt;br&amp;gt;+ &amp;lt;b&amp;gt;embedding&amp;lt;/b&amp;gt;: BLOB (Raw 384-dim Float32 vector, 1536 bytes)&amp;lt;br&amp;gt;+ &amp;lt;b&amp;gt;embedding_model&amp;lt;/b&amp;gt;: TEXT DEFAULT &#x27;bge-small-en-v1.5&#x27;&amp;lt;br&amp;gt;&amp;lt;i&amp;gt;INDEX idx_chunks_job_page ON document_chunks(job_id, page_num)&amp;lt;/i&amp;gt;&amp;lt;br&amp;gt;&amp;lt;i&amp;gt;Permits instantaneous FAISS index re-population without re-embedding&amp;lt;/i&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=2;fontColor=#064e3b;fontSize=12;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="570" y="100" width="460" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="t_sections" value="&amp;lt;b&amp;gt;report_sections&amp;lt;/b&amp;gt; (Extracted Statutory Disclosures)&amp;lt;hr&amp;gt;+ &amp;lt;b&amp;gt;id&amp;lt;/b&amp;gt;: INTEGER PRIMARY KEY AUTOINCREMENT&amp;lt;br&amp;gt;+ &amp;lt;b&amp;gt;job_id&amp;lt;/b&amp;gt;: INTEGER NOT NULL [FK &amp;amp;rarr; ingestion_jobs(id) ON DELETE CASCADE]&amp;lt;br&amp;gt;+ &amp;lt;b&amp;gt;group_id&amp;lt;/b&amp;gt;: TEXT NOT NULL (e.g., &#x27;section_a_corporate&#x27;, &#x27;principle_6&#x27;)&amp;lt;br&amp;gt;+ &amp;lt;b&amp;gt;data_json&amp;lt;/b&amp;gt;: TEXT NOT NULL (JSON payload of extracted metrics &amp;amp; tables)&amp;lt;br&amp;gt;+ &amp;lt;b&amp;gt;status&amp;lt;/b&amp;gt;: TEXT DEFAULT &#x27;EXTRACTED&#x27; (EXTRACTED | ACCEPTED | FAILED)&amp;lt;br&amp;gt;+ &amp;lt;b&amp;gt;updated_at&amp;lt;/b&amp;gt;: DATETIME DEFAULT CURRENT_TIMESTAMP&amp;lt;br&amp;gt;+ &amp;lt;b&amp;gt;UNIQUE(job_id, group_id)&amp;lt;/b&amp;gt; [Enforces idempotent updates]&amp;lt;br&amp;gt;&amp;lt;i&amp;gt;INDEX idx_sections_job_group ON report_sections(job_id, group_id)&amp;lt;/i&amp;gt;&amp;lt;br&amp;gt;&amp;lt;i&amp;gt;Maintains verified review state before final Inja HTML merge&amp;lt;/i&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=2;fontColor=#78350f;fontSize=12;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="570" y="420" width="460" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="n_db_notes" value="&amp;lt;b&amp;gt;Data Durability &amp;amp; Integrity Principles&amp;lt;/b&amp;gt;&amp;lt;hr&amp;gt;&amp;lt;b&amp;gt;1. Full Cascade Cleanup:&amp;lt;/b&amp;gt; Deleting a job (`DELETE /api/reports?job_id=X`) cleans up all associated documents, chunks, embeddings, and sections.&amp;lt;br&amp;gt;&amp;lt;b&amp;gt;2. Zero-Loss Vector Caching:&amp;lt;/b&amp;gt; Storing embeddings in `document_chunks.embedding` allows FAISS HNSW indexes to be rehydrated in RAM on server startup without calling the embedding model.&amp;lt;br&amp;gt;&amp;lt;b&amp;gt;3. Idempotent Section Updates:&amp;lt;/b&amp;gt; The `UNIQUE(job_id, group_id)` constraint ensures consultants can edit and re-save sections safely.&amp;lt;br&amp;gt;&amp;lt;b&amp;gt;4. Zero-Contamination Retrieval:&amp;lt;/b&amp;gt; All SQL lookups require `WHERE job_id = :id` preventing cross-enterprise data leakage." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=1;fontColor=#334155;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1080" y="100" width="440" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="n_db_perf" value="&amp;lt;b&amp;gt;Storage Performance &amp;amp; Hardware Telemetry&amp;lt;/b&amp;gt;&amp;lt;hr&amp;gt;&amp;bull; WAL Mode ensures concurrent read queries do not block background ingestion writes.&amp;lt;br&amp;gt;&amp;bull; Batch chunk inserts use prepared statements inside a single transaction: `BEGIN IMMEDIATE ... COMMIT`.&amp;lt;br&amp;gt;&amp;bull; Real-time database disk size (DB file + WAL journal) is streamed via `/api/system` and displayed in the QML client." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=1;fontColor=#334155;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1080" y="380" width="440" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="e_job_docs" value="1 : N (CASCADE)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2563eb;strokeWidth=2;fontColor=#1e40af;fontStyle=1;" edge="1" parent="1" source="t_jobs" target="t_docs">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_job_chunks" value="1 : N (CASCADE)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#059669;strokeWidth=2;fontColor=#064e3b;fontStyle=1;" edge="1" parent="1" source="t_jobs" target="t_chunks">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_doc_chunks" value="1 : N (CASCADE)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#7c3aed;strokeWidth=2;fontColor=#4c1d95;fontStyle=1;" edge="1" parent="1" source="t_docs" target="t_chunks">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_job_sections" value="1 : N (CASCADE)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d97706;strokeWidth=2;fontColor=#78350f;fontStyle=1;" edge="1" parent="1" source="t_jobs" target="t_sections">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>