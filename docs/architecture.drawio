        <mxCell id="n_qml_workspace" value="carbon-engine-client (Qt 6 Quick / QML)&lt;br&gt;- Modern VS Code Dark Modern Theme Palette&lt;br&gt;- DocumentsPanel: Multi-document queue &amp; stage&lt;br&gt;- CentralWorkspace: Live stage trackers &amp; HTML viewer&lt;br&gt;- RightPanel: Hardware status &amp; live activity log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0369a1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
