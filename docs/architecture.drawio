        <mxCell id="title" value="Carbon Engine — High-Performance On-Device ESG/BRSR System Architecture&lt;br&gt;Air-Gapped Native C++20 | llama.cpp (CUDA/CPU) | FAISS Vector Search | SQLite WAL | Qt 6 Quick Desktop Client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1480" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="c_ingest" value="1. Document Ingestion &amp; Text Processing (src/libs/ingestion)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#3b82f6;strokeWidth=2;fontColor=#1e40af;fontStyle=1;fontSize=13;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="460" height="430" as="geometry"/>
        </mxCell>
        <mxCell id="n_input_docs" value="Input Documents&lt;br&gt;(PDF, Scanned Binders,&lt;br&gt;Annual Reports)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#1e3a8a;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="140" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="n_doc_proc" value="DocumentProcessor&lt;br&gt;- PDFium Native Text Extraction&lt;br&gt;- Tesseract OCR + Leptonica&lt;br&gt;- UTF-8 Normalization" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="280" y="130" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="n_chunker" value="Sliding-Window Chunking&lt;br&gt;- 1,500 chars/chunk&lt;br&gt;- 300 char overlap window&lt;br&gt;- 1-based page attribution" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="280" y="240" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="n_job_queue" value="JobQueue (src/libs/queue)&lt;br&gt;- Async background worker&lt;br&gt;- SQLite backed job status&lt;br&gt;- Non-blocking network I/O" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#1e3a8a;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="240" width="180" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="n_chunks_out" value="Structured Chunks&lt;br&gt;[chunk_id, doc_id, page_num, text]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bfdbfe;strokeColor=#1d4ed8;fontColor=#1e3a8a;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="150" y="350" width="250" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="n_embed_worker" value="LlamaEngine Embedding Worker&lt;br&gt;- BGE-Small-EN-v1.5 (GGUF)&lt;br&gt;- 384-dimensional dense vectors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fed7aa;strokeColor=#ea580c;fontColor=#7c2d12;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="150" y="425" width="250" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="c_storage" value="2. Storage &amp; Vector Indexing (src/libs/db &amp; src/libs/vector)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#8b5cf6;strokeWidth=2;fontColor=#5b21b6;fontStyle=1;fontSize=13;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="530" y="90" width="470" height="430" as="geometry"/>
        </mxCell>
        <mxCell id="n_sqlite_db" value="SQLite WAL Storage (Database.cpp)&lt;br&gt;- PRAGMA journal_mode = WAL&lt;br&gt;- PRAGMA foreign_keys = ON&lt;br&gt;- Tables: ingestion_jobs, job_documents,&lt;br&gt;  document_chunks, report_sections&lt;br&gt;- Embeddings stored as binary BLOBs&lt;br&gt;- ON DELETE CASCADE for report isolation" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#4c1d95;fontStyle=1;fontSize=11;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="560" y="140" width="410" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="n_faiss_registry" value="VectorIndexRegistry (src/libs/vector)&lt;br&gt;- Job-Scoped Partitioning (No cross-doc contamination)&lt;br&gt;- FAISS HNSW Index per job (IndexHNSWFlat)&lt;br&gt;- Intel MKL AVX2 Hardware Acceleration&lt;br&gt;- Sub-second index rebuild from SQLite BLOBs on boot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontColor=#581c87;fontSize=11;align=left;spacingLeft=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="280" width="410" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="n_retrieval_engine" value="Two-Tier Scoped Retrieval&lt;br&gt;1. Locality Window Check (Chunk ID ± 2 on same page)&lt;br&gt;2. FAISS Vector Search (k=6 similarity candidates)&lt;br&gt;3. Single-batch SQL deduplicated fetch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#4c1d95;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="410" width="410" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="c_extract" value="3. Targeted Statutory Extraction &amp; Inference (src/libs/report &amp; inference)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#10b981;strokeWidth=2;fontColor=#047857;fontStyle=1;fontSize=13;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1030" y="90" width="490" height="430" as="geometry"/>
        </mxCell>
        <mxCell id="n_factstore" value="FactStore (FactStore.cpp)&lt;br&gt;- In-memory corporate anchor memoization&lt;br&gt;- Caches: FY, CIN, Turnover, Headcount, Net Worth&lt;br&gt;- Eliminates redundant LLM calls across principles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#059669;fontColor=#064e3b;fontStyle=1;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1060" y="140" width="430" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="n_brsr_schema" value="BrsrSchema Catalog (BrsrSchema.cpp)&lt;br&gt;- 12 Canonical SEBI Statutory Groups (A, B, P1-P9, Core)&lt;br&gt;- Targeted RAG Queries per section&lt;br&gt;- ~150 Field definitions &amp; 48 loop/table schemas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;fontColor=#064e3b;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1060" y="230" width="430" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="n_llama_gen" value="LlamaEngine (Qwen 2.5 7B Instruct GGUF)&lt;br&gt;- llama.cpp backend (GGML_CUDA or CPU AVX2)&lt;br&gt;- Middle-out context budget guard (preserves schema)&lt;br&gt;- KV Cache reuse across section generation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontStyle=1;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1060" y="320" width="430" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="n_json_repair" value="Resilient Multi-Pass JSON Parser&lt;br&gt;- autoRepairJson: cleans &#x27;: ,&#x27;, &#x27;: -&#x27;, &#x27;: N/A&#x27;, unclosed braces&lt;br&gt;- parseOrRecoverJson: regex fallback field salvager" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#059669;fontColor=#064e3b;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1060" y="420" width="430" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="c_api" value="4. Server Daemon &amp; REST API (src/apps/server &amp; src/libs/api)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#f59e0b;strokeWidth=2;fontColor=#b45309;fontStyle=1;fontSize=13;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="545" width="710" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="n_http_server" value="HTTPServer (src/libs/api/HTTPServer.cpp)&lt;br&gt;Qt HttpServer Daemon listening on http://localhost:8080&lt;br&gt;Endpoints:&lt;br&gt;- POST /api/ingest (Batch staging &amp; enqueuing)&lt;br&gt;- GET  /api/jobs (Ingestion progress polling)&lt;br&gt;- POST /api/extraction/start, GET /api/extraction/status&lt;br&gt;- GET/PUT /api/extraction/sections (Review &amp; edit)&lt;br&gt;- POST /api/extraction/accept (Lock report)&lt;br&gt;- POST /api/report/export (Inja HTML render)&lt;br&gt;- POST /api/chat (Job-scoped RAG assistant)&lt;br&gt;- GET  /api/system (Live hardware metrics)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;fontColor=#78350f;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="585" width="420" height="185" as="geometry"/>
        </mxCell>
        <mxCell id="n_sys_mon" value="SystemMonitor (src/libs/system)&lt;br&gt;- Physical RAM &amp; CPU % load&lt;br&gt;- VRAM &amp; GPU availability&lt;br&gt;- Inference tokens/second&lt;br&gt;- Live SQLite database disk size" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
