        <mxCell id="n_loop_grid" value="LoopFieldEditor (Tabular Data Grid)&lt;br&gt;- In-place editable spreadsheet-like table&lt;br&gt;- Human column headers (Product, NIC, Turnover %)&lt;br&gt;- Dynamic [+ Add Row] and [✕ Delete] controls&lt;br&gt;- Eliminates raw JSON editing for non-technical users&lt;br&gt;- Discreet collapsible { } Raw JSON toggle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bae6fd;strokeColor=#0284c7;fontColor=#0c4a6e;fontStyle=1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
