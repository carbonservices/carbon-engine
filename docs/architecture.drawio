        <mxCell id="c_client" value="5. ESG Consultant Desktop Application (src/apps/qml-client)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#0284c7;strokeWidth=2;fontColor=#0369a1;fontStyle=1;fontSize=13;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;" vertex="1" parent="1">
