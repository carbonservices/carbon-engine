        <mxCell id="n_qml_review" value="ReportReviewScreen &amp; FieldGroupCard&lt;br&gt;- Official SEBI BRSR terminology (BrsrMetadata.js)&lt;br&gt;- 2-Column responsive form grid for scalar numbers&lt;br&gt;- Collapsible missing-metrics notice badges&lt;br&gt;- Dark styled text inputs with focus highlighting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0369a1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
